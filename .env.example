# ── Database (MongoDB / Atlas) ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/operium

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── AI (Google Gemini: embeddings + summarization) ─────────────────────────
GOOGLE_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
API_PORT=4000
APP_URL=http://localhost:3000
NODE_ENV=development

# ── Embedding backfill worker (uses each user's own Gemini key) ─────────────
# EMBED_WORKER=off              # set to disable the background worker
# EMBED_WORKER_INTERVAL_MS=10000

# ── OAuth (GitHub login) ────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Firebase Admin (api — google sign-in verification) ──────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Web (apps/web — client-side config) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
