# ── Database (Neon / any Postgres with pgvector) ───────────────────────────
DATABASE_URL=postgres://user:password@host:5432/operium

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
ENCRYPTION_SECRET=change-me-32-bytes-min

# ── AI (Google Gemini: embeddings + summarization) ─────────────────────────
GOOGLE_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────--
API_PORT=4000
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
NODE_ENV=development

# ── OAuth (optional, for Claude.ai MCP connector) ──────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
